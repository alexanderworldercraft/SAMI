}

model Personne {
  PersonneID          Int                     @id @default(autoincrement())
  Nom                 String
  Prenom              String
  Surnom              String?
  CheminImage         String?
  ImageStatut         StatutImage             @default(DEFAULT)
  EtatID              Int                     @default(1)
  CreateDate          DateTime?               @default(now())
  Etat                Etat                    @relation(fields: [EtatID], references: [EtatID])
  Series              SeriesPersonne[]
  Videos              VideoPersonne[]
  DuplicateReviewsAsA PersonDuplicateReview[] @relation("PersonDuplicateReviewA")
  DuplicateReviewsAsB PersonDuplicateReview[] @relation("PersonDuplicateReviewB")

  @@index([EtatID], map: "Personne_EtatID_fkey")
}

model PersonDuplicateReview {
  PersonDuplicateReviewID Int                         @id @default(autoincrement())
  PersonneAID             Int
  PersonneBID             Int
  Decision                PersonDuplicateReviewStatus
  MergedPersonneID        Int?
  ReviewedByID            Int
  CreateDate              DateTime                    @default(now())
  UpdateDate              DateTime                    @updatedAt
  PersonneA               Personne                    @relation("PersonDuplicateReviewA", fields: [PersonneAID], references: [PersonneID], onDelete: Cascade)
  PersonneB               Personne                    @relation("PersonDuplicateReviewB", fields: [PersonneBID], references: [PersonneID], onDelete: Cascade)
  ReviewedBy              Utilisateur                 @relation(fields: [ReviewedByID], references: [UtilisateurID], onDelete: Restrict)

  @@unique([PersonneAID, PersonneBID], map: "uniq_person_duplicate_pair")
  @@index([Decision], map: "idx_person_duplicate_decision")
  @@index([ReviewedByID], map: "idx_person_duplicate_reviewer")
}

model VideoPersonne {
  VideoPersonneID Int       @id @default(autoincrement())
  VideoID         Int
  PersonneID      Int
  EstActeur       Boolean   @default(false)
  EstRealisateur  Boolean   @default(false)
  CreateDate      DateTime? @default(now())
  Personne        Personne  @relation(fields: [PersonneID], references: [PersonneID])
  Video           Video     @relation(fields: [VideoID], references: [VideoID])

  @@unique([VideoID, PersonneID])
  @@index([PersonneID])
  @@index([VideoID])
}

model SeriesPersonne {
  SeriesPersonneID Int       @id @default(autoincrement())
  SeriesID         Int
  PersonneID       Int
  EstActeur        Boolean   @default(false)
  EstRealisateur   Boolean   @default(false)
  CreateDate       DateTime? @default(now())
  Personne         Personne  @relation(fields: [PersonneID], references: [PersonneID])
  Series           Series    @relation(fields: [SeriesID], references: [SeriesID])

  @@unique([SeriesID, PersonneID])
  @@index([PersonneID])
  @@index([SeriesID])
}

enum StatutImage {
  DEFAULT
  CUSTOM
}

enum PersonDuplicateReviewStatus {
  DOUBT
  DISTINCT
  MERGED
}
