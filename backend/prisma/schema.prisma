generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Etat {
  EtatID       Int           @id @default(autoincrement())
  Nom          String        @unique @db.VarChar(100)
  CreateDate   DateTime?     @default(now())
  Albums       Album[]
  Sagas        Saga[]
  Universes    Universe[]
  Musiques     Musique[]
  Personnes    Personne[]
  Series       Series[]
  Utilisateurs Utilisateur[]
  Videos       Video[]
}

model Grade {
  GradeID      Int           @id @default(autoincrement())
  Nom          String        @unique @db.VarChar(50)
  CreateDate   DateTime?     @default(now())
  Utilisateurs Utilisateur[]
}

model Genre {
  GenreID          Int                    @id @default(autoincrement())
  Nom              String                 @unique @db.VarChar(50)
  CreateDate       DateTime?              @default(now())
  FeaturedContent  GenreFeaturedContent?
  HomepageDefaults HomepageDefaultGenre[]
  SeriesGenres     SeriesGenre[]
  UtilisateurGenre UtilisateurGenre[]
  VideoGenres      VideoGenre[]
}

model Series {
  SeriesID             Int                    @id @default(autoincrement())
  Titre                String                 @db.VarChar(100)
  Resumer              String                 @db.Text
  CheminImage          String                 @db.VarChar(255)
  EtatID               Int
  CreateDate           DateTime?              @default(now())
  UtilisateurID        Int?
  Premium              Boolean                @default(false)
  Log                  Log[]
  Saisons              Saison[]
  Etat                 Etat                   @relation(fields: [EtatID], references: [EtatID])
  Utilisateur          Utilisateur?           @relation(fields: [UtilisateurID], references: [UtilisateurID])
  SeriesGenres         SeriesGenre[]
  SeriesPersonne       SeriesPersonne[]
  SagaContents         SagaContent[]
  UniverseContents     UniverseContent[]
  UserSeriesWatchReset UserSeriesWatchReset[]
  GenreFeaturedContent GenreFeaturedContent[]
  UserFavoriteContent  UserFavoriteContent[]

  @@index([EtatID], map: "Series_EtatID_fkey")
  @@index([UtilisateurID], map: "Series_UtilisateurID_fkey")
}

model SeriesGenre {
  SeriesGenreID Int       @id @default(autoincrement())
  SeriesID      Int
  GenreID       Int
  CreateDate    DateTime? @default(now())
  Genre         Genre     @relation(fields: [GenreID], references: [GenreID])
  Series        Series    @relation(fields: [SeriesID], references: [SeriesID])

  @@index([GenreID], map: "SeriesGenre_GenreID_fkey")
  @@index([SeriesID], map: "SeriesGenre_SeriesID_fkey")
}

model Saison {
  SaisonID      Int          @id @default(autoincrement())
  Numero        Int
  SeriesID      Int
  CreateDate    DateTime?    @default(now())
  UtilisateurID Int?
  Log           Log[]
  Series        Series       @relation(fields: [SeriesID], references: [SeriesID])
  Utilisateur   Utilisateur? @relation(fields: [UtilisateurID], references: [UtilisateurID])
  Episodes      Video[]

  @@index([SeriesID], map: "Saison_SeriesID_fkey")
  @@index([UtilisateurID], map: "Saison_UtilisateurID_fkey")
}

model Video {
  VideoID              Int                    @id @default(autoincrement())
  Titre                String                 @db.VarChar(100)
  Resumer              String?                @db.Text
  CheminAcces          String                 @db.VarChar(255)
  CheminImage          String?                @db.VarChar(255)
  EtatID               Int
  SaisonID             Int?
  CreateDate           DateTime?              @default(now())
  UtilisateurID        Int?
  Premium              Boolean                @default(false)
  Log                  Log[]
  Etat                 Etat                   @relation(fields: [EtatID], references: [EtatID])
  Saison               Saison?                @relation(fields: [SaisonID], references: [SaisonID])
  Utilisateur          Utilisateur?           @relation(fields: [UtilisateurID], references: [UtilisateurID])
  VideoGenres          VideoGenre[]
  VideoPersonne        VideoPersonne[]
  SagaContents         SagaContent[]
  UniverseContents     UniverseContent[]
  UserVideoProgress    UserVideoProgress[]
  VideoSubtitles       VideoSubtitle[]
  VideoAudioTracks     VideoAudioTrack[]
  AiSubtitleJobs       AiSubtitleJob[]
  AiTranscript         AiVideoTranscript?
  GenreFeaturedContent GenreFeaturedContent[]
  UserFavoriteContent  UserFavoriteContent[]

  @@index([EtatID], map: "Video_EtatID_fkey")
  @@index([SaisonID], map: "Video_SaisonID_fkey")
  @@index([UtilisateurID], map: "Video_UtilisateurID_fkey")
}

model VideoGenre {
  VideoGenreID Int       @id @default(autoincrement())
  VideoID      Int
  GenreID      Int
  CreateDate   DateTime? @default(now())
  Genre        Genre     @relation(fields: [GenreID], references: [GenreID])
  Video        Video     @relation(fields: [VideoID], references: [VideoID])

  @@index([GenreID], map: "VideoGenre_GenreID_fkey")
  @@index([VideoID], map: "VideoGenre_VideoID_fkey")
}

model VideoSubtitle {
  VideoSubtitleID Int            @id @default(autoincrement())
  Label           String         @db.VarChar(100)
  CheminSubtitle  String         @db.VarChar(255)
  Language        String?        @db.VarChar(35)
  Type            String         @default("FULL") @db.VarChar(16)
  Origin          String         @default("IMPORTED") @db.VarChar(16)
  AiSubtitleJobID String?        @unique @db.VarChar(36)
  VideoID         Int
  CreateDate      DateTime?      @default(now())
  Video           Video          @relation(fields: [VideoID], references: [VideoID])
  AiSubtitleJob   AiSubtitleJob? @relation(fields: [AiSubtitleJobID], references: [AiSubtitleJobID], onDelete: SetNull)

  @@index([VideoID], map: "VideoSubtitle_VideoID_fkey")
}

model VideoAudioTrack {
  VideoAudioTrackID Int       @id @default(autoincrement())
  Label             String    @db.VarChar(100)
  Language          String?   @db.VarChar(35)
  CheminPlaylist    String    @db.VarChar(255)
  IsDefault         Boolean   @default(false)
  Ordre             Int
  VideoID           Int
  CreateDate        DateTime? @default(now())
  Video             Video     @relation(fields: [VideoID], references: [VideoID])

  @@unique([VideoID, Ordre])
  @@index([VideoID], map: "VideoAudioTrack_VideoID_fkey")
}

model VideoTransfer {
  VideoTransferID     String              @id @db.VarChar(36)
  Direction           String              @db.VarChar(16)
  SourceInstanceID    String              @db.VarChar(100)
  SourceVideoID       Int
  DestinationVideoID  Int?
  DestinationSeasonID Int?
  InitiatedByUserID   Int?
  InitiatedByNickname String?             @db.VarChar(191)
  RemoteTransferID    String?             @db.VarChar(36)
  ManifestHash        String?             @db.Char(64)
  Manifest            Json?
  Receipt             Json?
  Warnings            Json?
  Status              String              @db.VarChar(32)
  CurrentStep         String?             @db.VarChar(64)
  Progress            Int                 @default(0)
  TotalFiles          Int                 @default(0)
  TransferredFiles    Int                 @default(0)
  TotalBytes          BigInt              @default(0)
  TransferredBytes    BigInt              @default(0)
  CancelRequested     Boolean             @default(false)
  ResumeCount         Int                 @default(0)
  ErrorMessage        String?             @db.Text
  StartedAt           DateTime?
  CompletedAt         DateTime?
  CreatedAt           DateTime            @default(now())
  UpdatedAt           DateTime            @default(now()) @updatedAt
  Files               VideoTransferFile[]
  Steps               VideoTransferStep[]

  @@unique([Direction, SourceInstanceID, SourceVideoID], name: "Direction_SourceInstanceID_SourceVideoID", map: "uniq_video_transfer_source")
  @@index([Status, UpdatedAt], map: "idx_video_transfer_status_updated")
  @@index([RemoteTransferID], map: "idx_video_transfer_remote")
}

model VideoTransferFile {
  VideoTransferFileID String        @id @db.VarChar(36)
  VideoTransferID     String        @db.VarChar(36)
  RelativePath        String        @db.VarChar(512)
  Size                BigInt
  Sha256              String        @db.Char(64)
  Status              String        @db.VarChar(24)
  BytesReceived       BigInt        @default(0)
  CreatedAt           DateTime      @default(now())
  UpdatedAt           DateTime      @default(now()) @updatedAt
  Transfer            VideoTransfer @relation(fields: [VideoTransferID], references: [VideoTransferID], onDelete: Cascade)

  @@unique([VideoTransferID, RelativePath], name: "VideoTransferID_RelativePath", map: "uniq_video_transfer_file_path")
  @@index([VideoTransferID, Status], map: "idx_video_transfer_file_status")
}

model VideoTransferStep {
  VideoTransferStepID BigInt        @id @default(autoincrement())
  VideoTransferID     String        @db.VarChar(36)
  StepKey             String        @db.VarChar(64)
  Label               String        @db.VarChar(191)
  StatusLabel         String        @db.VarChar(191)
  Progress            Int           @default(0)
  Status              String        @db.VarChar(24)
  ErrorMessage        String?       @db.Text
  StartedAt           DateTime?
  CompletedAt         DateTime?
  CreatedAt           DateTime      @default(now())
  UpdatedAt           DateTime      @default(now()) @updatedAt
  Transfer            VideoTransfer @relation(fields: [VideoTransferID], references: [VideoTransferID], onDelete: Cascade)

  @@unique([VideoTransferID, StepKey], name: "VideoTransferID_StepKey", map: "uniq_video_transfer_step")
  @@index([VideoTransferID, Status], map: "idx_video_transfer_step_status")
}

model VideoEncodingWorker {
  VideoEncodingWorkerID String                      @id @db.VarChar(100)
  DisplayName           String?                     @db.VarChar(191)
  Role                  String                      @db.VarChar(16)
  Enabled               Boolean                     @default(false)
  Draining              Boolean                     @default(false)
  ProtocolVersion       Int                         @default(1)
  PipelineVersion       String                      @db.VarChar(64)
  Platform              String?                     @db.VarChar(64)
  Architecture          String?                     @db.VarChar(64)
  FfmpegVersion         String?                     @db.VarChar(191)
  MaxNominalHeight      Int                         @default(0)
  SupportsH264          Boolean                     @default(true)
  SupportsAac           Boolean                     @default(true)
  MaxSlots              Int                         @default(1)
  PerformanceScore      Float                       @default(1)
  Capabilities          Json?
  BootID                String?                     @db.VarChar(100)
  LastHeartbeatAt       DateTime?
  LastError             String?                     @db.Text
  CreatedAt             DateTime                    @default(now())
  UpdatedAt             DateTime                    @default(now()) @updatedAt
  AssignedTasks         VideoEncodingTask[]         @relation("EncodingTaskAssignedWorker")
  PreferredTasks        VideoEncodingTask[]         @relation("EncodingTaskPreferredWorker")
  Attempts              VideoEncodingTaskAttempt[]
  RequestNonces         VideoEncodingRequestNonce[]
  AiSubtitleWorker      AiSubtitleWorker?

  @@index([Role, Enabled, LastHeartbeatAt], map: "idx_encoding_worker_availability")
  @@index([PipelineVersion, MaxNominalHeight], map: "idx_encoding_worker_capability")
}

model AiSubtitleWorker {
  AiSubtitleWorkerID String              @id @db.VarChar(100)
  Role               String              @db.VarChar(16)
  Ready              Boolean             @default(false)
  Engine             String?             @db.VarChar(64)
  Device             String?             @db.VarChar(64)
  Model              String?             @db.VarChar(120)
  TranslationModel   String?             @db.VarChar(191)
  PipelineVersion    String              @db.VarChar(64)
  PerformanceScore   Float               @default(1)
  MaxSlots           Int                 @default(1)
  Capabilities       Json?
  BootID             String?             @db.VarChar(100)
  LastHeartbeatAt    DateTime?
  LastError          String?             @db.Text
  CreatedAt          DateTime            @default(now())
  UpdatedAt          DateTime            @default(now()) @updatedAt
  Registry           VideoEncodingWorker @relation(fields: [AiSubtitleWorkerID], references: [VideoEncodingWorkerID], onDelete: Cascade)
  AssignedJobs       AiSubtitleJob[]

  @@index([Ready, LastHeartbeatAt, PerformanceScore], map: "idx_ai_subtitle_worker_availability")
}

model AiSubtitleJob {
  AiSubtitleJobID    String            @id @db.VarChar(36)
  VideoID            Int
  TargetLanguage     String            @db.VarChar(35)
  RequestedByUserID  Int?
  Automatic          Boolean           @default(false)
  Status             String            @db.VarChar(24)
  Phase              String?           @db.VarChar(32)
  Progress           Int               @default(0)
  SourceRelativePath String?           @db.VarChar(512)
  SourceSize         BigInt?
  SourceSha256       String?           @db.Char(64)
  AssignedWorkerID   String?           @db.VarChar(100)
  LeaseTokenHash     String?           @db.Char(64)
  LeaseGeneration    Int               @default(0)
  LeaseExpiresAt     DateTime?
  AttemptCount       Int               @default(0)
  MaxAttempts        Int               @default(4)
  NextEligibleAt     DateTime?
  SourceLanguage     String?           @db.VarChar(35)
  TranscriptionModel String?           @db.VarChar(120)
  TranslationModel   String?           @db.VarChar(191)
  PipelineVersion    String            @db.VarChar(64)
  ErrorMessage       String?           @db.Text
  StartedAt          DateTime?
  CompletedAt        DateTime?
  CreatedAt          DateTime          @default(now())
  UpdatedAt          DateTime          @default(now()) @updatedAt
  Video              Video             @relation(fields: [VideoID], references: [VideoID], onDelete: Cascade)
  RequestedBy        Utilisateur?      @relation(fields: [RequestedByUserID], references: [UtilisateurID], onDelete: SetNull)
  AssignedWorker     AiSubtitleWorker? @relation(fields: [AssignedWorkerID], references: [AiSubtitleWorkerID], onDelete: SetNull)
  GeneratedSubtitle  VideoSubtitle?

  @@unique([VideoID, TargetLanguage], name: "VideoID_TargetLanguage", map: "uniq_ai_subtitle_video_language")
  @@index([Status, NextEligibleAt, CreatedAt], map: "idx_ai_subtitle_job_queue")
  @@index([AssignedWorkerID, Status], map: "idx_ai_subtitle_job_worker")
  @@index([LeaseExpiresAt], map: "idx_ai_subtitle_job_lease")
  @@index([RequestedByUserID], map: "idx_ai_subtitle_job_requester")
}

model AiVideoTranscript {
  VideoID            Int      @id
  SourceLanguage     String   @db.VarChar(35)
  Segments           Json
  PlainText          String?  @db.LongText
  TranscriptionModel String   @db.VarChar(120)
  PipelineVersion    String   @db.VarChar(64)
  CreatedAt          DateTime @default(now())
  UpdatedAt          DateTime @default(now()) @updatedAt
  Video              Video    @relation(fields: [VideoID], references: [VideoID], onDelete: Cascade)
}

model VideoEncodingJob {
  VideoEncodingJobID String              @id @db.VarChar(36)
  VideoID            Int?
  IdempotencyKey     String?             @db.VarChar(191)
  InitiatedByUserID  Int?
  Status             String              @db.VarChar(32)
  CurrentStep        String?             @db.VarChar(64)
  Progress           Int                 @default(0)
  SourceRelativePath String              @db.VarChar(512)
  SourceOriginalName String              @db.VarChar(255)
  SourceSize         BigInt
  SourceSha256       String              @db.Char(64)
  SourceMetadata     Json?
  RequestSnapshot    Json
  PipelineVersion    String              @db.VarChar(64)
  EncodingSpecHash   String              @db.Char(64)
  CancelRequested    Boolean             @default(false)
  ErrorMessage       String?             @db.Text
  Warnings           Json?
  NoCloneSinceAt     DateTime?
  StartedAt          DateTime?
  CompletedAt        DateTime?
  CreatedAt          DateTime            @default(now())
  UpdatedAt          DateTime            @default(now()) @updatedAt
  Tasks              VideoEncodingTask[]

  @@unique([InitiatedByUserID, IdempotencyKey], name: "InitiatedByUserID_IdempotencyKey", map: "uniq_encoding_job_idempotency")
  @@index([Status, UpdatedAt], map: "idx_encoding_job_status_updated")
  @@index([VideoID], map: "idx_encoding_job_video")
}

model VideoEncodingTask {
  VideoEncodingTaskID  String                     @id @db.VarChar(36)
  VideoEncodingJobID   String                     @db.VarChar(36)
  TaskKey              String                     @db.VarChar(100)
  Kind                 String                     @db.VarChar(32)
  ProfileLabel         String?                    @db.VarChar(32)
  NominalHeight        Int?
  Priority             Int                        @default(0)
  Weight               BigInt                     @default(0)
  Required             Boolean                    @default(true)
  Spec                 Json
  SpecHash             String                     @db.Char(64)
  Status               String                     @db.VarChar(24)
  Phase                String?                    @db.VarChar(24)
  AssignedWorkerID     String?                    @db.VarChar(100)
  PreferredWorkerID    String?                    @db.VarChar(100)
  PreferenceExpiresAt  DateTime?
  LeaseTokenHash       String?                    @db.Char(64)
  LeaseGeneration      Int                        @default(0)
  LeaseExpiresAt       DateTime?
  AttemptCount         Int                        @default(0)
  MaxAttempts          Int                        @default(4)
  NextEligibleAt       DateTime?
  Progress             Int                        @default(0)
  ArtifactManifest     Json?
  ArtifactManifestHash String?                    @db.Char(64)
  ErrorMessage         String?                    @db.Text
  StartedAt            DateTime?
  CompletedAt          DateTime?
  CreatedAt            DateTime                   @default(now())
  UpdatedAt            DateTime                   @default(now()) @updatedAt
  Job                  VideoEncodingJob           @relation(fields: [VideoEncodingJobID], references: [VideoEncodingJobID], onDelete: Cascade)
  AssignedWorker       VideoEncodingWorker?       @relation("EncodingTaskAssignedWorker", fields: [AssignedWorkerID], references: [VideoEncodingWorkerID], onDelete: SetNull)
  PreferredWorker      VideoEncodingWorker?       @relation("EncodingTaskPreferredWorker", fields: [PreferredWorkerID], references: [VideoEncodingWorkerID], onDelete: SetNull)
  Attempts             VideoEncodingTaskAttempt[]

  @@unique([VideoEncodingJobID, TaskKey], name: "VideoEncodingJobID_TaskKey", map: "uniq_encoding_task_key")
  @@index([Status, NextEligibleAt, Priority], map: "idx_encoding_task_queue")
  @@index([LeaseExpiresAt], map: "idx_encoding_task_lease_expiry")
  @@index([AssignedWorkerID, Status], map: "idx_encoding_task_worker_status")
  @@index([PreferredWorkerID, PreferenceExpiresAt], map: "idx_encoding_task_preference")
}

model VideoEncodingTaskAttempt {
  VideoEncodingTaskAttemptID String                      @id @db.VarChar(36)
  VideoEncodingTaskID        String                      @db.VarChar(36)
  VideoEncodingWorkerID      String                      @db.VarChar(100)
  AttemptNumber              Int
  LeaseGeneration            Int
  Status                     String                      @db.VarChar(24)
  Progress                   Int                         @default(0)
  ManifestHash               String?                     @db.Char(64)
  ErrorMessage               String?                     @db.Text
  StartedAt                  DateTime                    @default(now())
  LastRenewedAt              DateTime?
  CompletedAt                DateTime?
  CreatedAt                  DateTime                    @default(now())
  UpdatedAt                  DateTime                    @default(now()) @updatedAt
  Task                       VideoEncodingTask           @relation(fields: [VideoEncodingTaskID], references: [VideoEncodingTaskID], onDelete: Cascade)
  Worker                     VideoEncodingWorker         @relation(fields: [VideoEncodingWorkerID], references: [VideoEncodingWorkerID])
  Files                      VideoEncodingArtifactFile[]

  @@unique([VideoEncodingTaskID, AttemptNumber], name: "VideoEncodingTaskID_AttemptNumber", map: "uniq_encoding_task_attempt")
  @@index([VideoEncodingWorkerID, Status], map: "idx_encoding_attempt_worker_status")
}

model VideoEncodingArtifactFile {
  VideoEncodingArtifactFileID String                   @id @db.VarChar(36)
  VideoEncodingTaskAttemptID  String                   @db.VarChar(36)
  RelativePath                String                   @db.VarChar(512)
  Size                        BigInt
  Sha256                      String                   @db.Char(64)
  Status                      String                   @db.VarChar(24)
  BytesReceived               BigInt                   @default(0)
  CreatedAt                   DateTime                 @default(now())
  UpdatedAt                   DateTime                 @default(now()) @updatedAt
  Attempt                     VideoEncodingTaskAttempt @relation(fields: [VideoEncodingTaskAttemptID], references: [VideoEncodingTaskAttemptID], onDelete: Cascade)

  @@unique([VideoEncodingTaskAttemptID, RelativePath], name: "VideoEncodingTaskAttemptID_RelativePath", map: "uniq_encoding_artifact_path")
  @@index([VideoEncodingTaskAttemptID, Status], map: "idx_encoding_artifact_status")
}

model VideoEncodingRequestNonce {
  VideoEncodingRequestNonceID BigInt              @id @default(autoincrement())
  VideoEncodingWorkerID       String              @db.VarChar(100)
  Nonce                       String              @db.VarChar(128)
  ExpiresAt                   DateTime
  CreatedAt                   DateTime            @default(now())
  Worker                      VideoEncodingWorker @relation(fields: [VideoEncodingWorkerID], references: [VideoEncodingWorkerID], onDelete: Cascade)

  @@unique([VideoEncodingWorkerID, Nonce], name: "VideoEncodingWorkerID_Nonce", map: "uniq_encoding_request_nonce")
  @@index([ExpiresAt], map: "idx_encoding_request_nonce_expiry")
}

model Saga {
  SagaID        Int            @id @default(autoincrement())
  Titre         String         @db.VarChar(100)
  Resumer       String?        @db.Text
  CheminImage   String?        @db.VarChar(255)
  EtatID        Int
  Premium       Boolean        @default(false)
  CreateDate    DateTime?      @default(now())
  Etat          Etat           @relation(fields: [EtatID], references: [EtatID])
  SagaContents  SagaContent[]
  UniverseSagas UniverseSaga[]

  @@index([EtatID], map: "Saga_EtatID_fkey")
}

model Universe {
  UniverseID       Int               @id @default(autoincrement())
  Titre            String            @db.VarChar(100)
  Resume           String?           @db.Text
  EtatID           Int
  CreateDate       DateTime?         @default(now())
  Etat             Etat              @relation(fields: [EtatID], references: [EtatID])
  UniverseSagas    UniverseSaga[]
  UniverseContents UniverseContent[]

  @@index([EtatID], map: "Universe_EtatID_fkey")
}

model UniverseSaga {
  UniverseSagaID Int       @id @default(autoincrement())
  UniverseID     Int
  SagaID         Int
  Ordre          Int       @default(0)
  CreateDate     DateTime? @default(now())
  Universe       Universe  @relation(fields: [UniverseID], references: [UniverseID], onDelete: Cascade)
  Saga           Saga      @relation(fields: [SagaID], references: [SagaID], onDelete: Cascade)

  @@unique([UniverseID, SagaID], map: "uniq_universe_saga")
  @@index([UniverseID, Ordre], map: "idx_universe_saga_order")
  @@index([SagaID], map: "UniverseSaga_SagaID_fkey")
}

model UniverseContent {
  UniverseContentID Int       @id @default(autoincrement())
  UniverseID        Int
  VideoID           Int?
  SeriesID          Int?
  Ordre             Int       @default(0)
  CreateDate        DateTime? @default(now())
  Universe          Universe  @relation(fields: [UniverseID], references: [UniverseID], onDelete: Cascade)
  Video             Video?    @relation(fields: [VideoID], references: [VideoID], onDelete: Cascade)
  Series            Series?   @relation(fields: [SeriesID], references: [SeriesID], onDelete: Cascade)

  @@unique([UniverseID, VideoID], map: "uniq_universe_video")
  @@unique([UniverseID, SeriesID], map: "uniq_universe_series")
  @@index([UniverseID, Ordre], map: "idx_universe_content_order")
  @@index([VideoID], map: "UniverseContent_VideoID_fkey")
  @@index([SeriesID], map: "UniverseContent_SeriesID_fkey")
}

model SagaContent {
  SagaContentID Int       @id @default(autoincrement())
  SagaID        Int
  VideoID       Int?
  SeriesID      Int?
  Ordre         Int       @default(0)
  CreateDate    DateTime? @default(now())
  Saga          Saga      @relation(fields: [SagaID], references: [SagaID], onDelete: Cascade)
  Video         Video?    @relation(fields: [VideoID], references: [VideoID], onDelete: Cascade)
  Series        Series?   @relation(fields: [SeriesID], references: [SeriesID], onDelete: Cascade)

  @@unique([SagaID, VideoID], map: "uniq_saga_video")
  @@unique([SagaID, SeriesID], map: "uniq_saga_series")
  @@index([SagaID, Ordre], map: "idx_saga_content_order")
  @@index([VideoID], map: "SagaContent_VideoID_fkey")
  @@index([SeriesID], map: "SagaContent_SeriesID_fkey")
}

model UtilisateurGenre {
  UtilisateurGenreID Int         @id @default(autoincrement())
  UtilisateurID      Int
  GenreID            Int
  CreateDate         DateTime?   @default(now())
  Genre              Genre       @relation(fields: [GenreID], references: [GenreID])
  Utilisateur        Utilisateur @relation(fields: [UtilisateurID], references: [UtilisateurID])

  @@index([GenreID], map: "UtilisateurGenre_GenreID_fkey")
  @@index([UtilisateurID], map: "UtilisateurGenre_UtilisateurID_fkey")
}

model Utilisateur {
  UtilisateurID          Int                     @id @default(autoincrement())
  Surnom                 String                  @unique
  MotDePasse             String                  @db.VarChar(255)
  CheminImage            String?                 @db.VarChar(255)
  Email                  String                  @db.VarChar(100)
  Salt                   String                  @db.VarChar(255)
  GradeID                Int
  EtatID                 Int
  CreateDate             DateTime?               @default(now())
  LastLogin              DateTime?
  PremiumEndDate         DateTime?
  Log                    Log[]
  Albums                 Album[]
  AlbumMusiques          AlbumMusique[]
  Musiques               Musique[]
  MusiqueGenres          MusiqueGenre[]
  MusiqueGenreAlbums     MusiqueGenreAlbum[]
  MusiqueGenreMusiques   MusiqueGenreMusique[]
  Saisons                Saison[]
  Seriess                Series[]
  Etat                   Etat                    @relation(fields: [EtatID], references: [EtatID])
  Grade                  Grade                   @relation(fields: [GradeID], references: [GradeID])
  UtilisateurGenre       UtilisateurGenre[]
  Videos                 Video[]
  UserVideoProgress      UserVideoProgress[]
  UserSeriesWatchReset   UserSeriesWatchReset[]
  UserFavoriteContent    UserFavoriteContent[]
  PlayerPreference       UserPlayerPreference?
  PersonDuplicateReviews PersonDuplicateReview[]
  AiSubtitleJobs         AiSubtitleJob[]

  @@index([GradeID], map: "Utilisateur_GradeID_fkey")
