DATABASE_URL="mysql://sami_user:sami_password@localhost:3306/sami"

DB_HOST="localhost"
DB_USER="sami_user"
DB_PASSWORD="change-me-database-password"
DB_NAME="sami"

BACKUP_DAY_OF_WEEK="0"
BACKUP_TIME="00:00"

JWT_SECRET="change-me-with-a-long-random-secret"
FAKE_PAYMENT_WEBHOOK_SECRET="change-me-with-a-long-random-secret"
# Utilisez "production" sur le clone et le serveur principal déployés.
NODE_ENV="development"
APP_NAME="SAMI"
WIKIMEDIA_USER_AGENT="SAMI-image-import-bot/1.0 (mailto:admin@example.com)"

# Rôle de cette installation : "clone" pour exporter, "primary" pour recevoir.
# Sur le principal, utilisez par exemple SAMI_INSTANCE_ID="sami-primary".
# SAMI_PRIMARY_BASE_URL reste configurable et peut être changée sans modifier le code.
# Déployez un seul processus backend par installation (verrous et nonces en mémoire).
SAMI_INSTANCE_ROLE="clone"
SAMI_INSTANCE_ID="sami-clone-01"
SAMI_PRIMARY_BASE_URL="https://sami.worldercraft.fr"
SAMI_TRANSFER_SHARED_SECRET="change-me-with-at-least-32-random-bytes"
SAMI_TRANSFER_REQUEST_TIMEOUT_MS="120000"
SAMI_TRANSFER_SESSION_TTL_HOURS="168"
SAMI_TRANSFER_CONCURRENCY="2"

# Encodage multi-server expérimental. Laissez désactivé jusqu'à ce que la
# migration soit appliquée sur le primary et que les clones soient enregistrés.
SAMI_DISTRIBUTED_ENCODING_ENABLED="false"
# Optionnel : doit rester identique sur toutes les instances d'un même pool.
SAMI_DISTRIBUTED_ENCODING_PIPELINE_VERSION="sami-hls-libx264-aac-v1"
# Rétention BDD sur le primary : artefacts détaillés puis historique complet.
SAMI_DISTRIBUTED_ENCODING_ARTIFACT_RETENTION_DAYS="1"
SAMI_DISTRIBUTED_ENCODING_JOB_RETENTION_DAYS="30"
# Stockages privés optionnels ; les valeurs par défaut sont sous backend/var.
# SAMI_DISTRIBUTED_ENCODING_SOURCE_ROOT="/srv/sami/video-encoding/sources"
# SAMI_DISTRIBUTED_ENCODING_CACHE_ROOT="/srv/sami/video-encoding-cache"
# SAMI_DISTRIBUTED_ENCODING_STAGING_ROOT="/srv/sami/video-encoding-staging"
# Chemins optionnels, utiles si ffmpeg/ffprobe ne sont pas dans le PATH
# (par exemple sous Windows).
# FFMPEG_PATH="C:/ffmpeg/bin/ffmpeg.exe"
# FFPROBE_PATH="C:/ffmpeg/bin/ffprobe.exe"

# Sous-titres IA locaux expérimentaux. Exécutez d'abord `npm run setup:ai`
# sur chaque installation. Le réglage applicatif reste désactivé jusqu'à son
# activation explicite depuis Administration.
SAMI_AI_SUBTITLES_ENABLED="false"
SAMI_AI_SUBTITLE_PIPELINE_VERSION="sami-ai-subtitles-v2-contextual-quality-r3-word-timing"
SAMI_AI_SUBTITLE_TRANSLATION_MODEL="facebook/nllb-200-distilled-1.3B"
SAMI_AI_SUBTITLE_MODEL="large-v3"
SAMI_AI_SUBTITLE_ENGINE="auto"
# Priorités conseillées : RTX 3090=100, RTX 3070=80, Mac 24 Go=60, RX 6700 XT=40.
SAMI_AI_SUBTITLE_PERFORMANCE_SCORE="1"
# Index PyTorch optionnel, principalement pour imposer une build CUDA/CPU précise.
# SAMI_AI_TORCH_INDEX_URL="https://download.pytorch.org/whl/cpu"
# SAMI_AI_SUBTITLE_ROOT="/srv/sami/ai-subtitles"
# SAMI_AI_SYSTEM_PYTHON="/usr/bin/python3"

# Doublage IA distribué. Le primary peut coordonner sans runtime local ; le clone
# NVIDIA exécute `npm run setup:ai-dubbing` puis travaille sans réseau modèle.
SAMI_AI_DUBBING_ENABLED="false"
SAMI_AI_DUBBING_WORKER_ENABLED="false"
SAMI_AI_DUBBING_COMMAND=""
# SAMI_AI_DUBBING_ROOT="/srv/sami/ai-dubbing"
SAMI_AI_DUBBING_PIPELINE_VERSION="sami-dubbing-v6-clean-phrases-r9-r1"
SAMI_AI_DUBBING_VOICE_ENGINE="qwen3-tts"
SAMI_AI_DUBBING_VOICE_MODEL="Qwen/Qwen3-TTS-12Hz-1.7B-Base"
SAMI_AI_DUBBING_VOICE_MODEL_REVISION="fd4b254389122332181a7c3db7f27e918eec64e3"
SAMI_AI_DUBBING_SEPARATION_MODEL="bandit-v2-multi"
SAMI_AI_DUBBING_PERFORMANCE_SCORE="100"
# Profils de doublage disponibles (même valeur obligatoire sur le primary et le clone) :
# - sami-dubbing-v5-aligned-quality : V5 historique, Pyannote seul, fenêtres strictes, accélération 1,5×.
# - sami-dubbing-v5-stable-boundaries-r1 : V5 avec micro-fragments internes stabilisés ; sous-titres courts conservés.
# - sami-dubbing-v5-aligned-sentences-r2 : V5 R1 + réparation auditée des coupures dans le premier mot d'une phrase source alignée.
# - sami-dubbing-v5-flexible-tails-r3 : V5 R2 + départ fixe, fin prolongée au minimum nécessaire à 1,5× maximum.
# - sami-dubbing-v5-guided-references-r4 : V5 R3 + références manuelles facultatives, une principale et des alternatives, sans concaténation.
# - sami-dubbing-v5-guided-references-r4-r1 : R4 + contrôle adapté aux répliques courtes, génération initiale déterministe et meilleure tentative signalée.
# - sami-dubbing-v5-guided-references-r4-r2 : R4-R1 + contractions à apostrophe comptées comme un seul mot parlé.
# - sami-dubbing-v5-translated-clauses-r5 : R4-R2 + traductions découpées à la ponctuation, attribution signalée et courts audios rejetés privés.
# - sami-dubbing-v5-bounded-samples-r5-r1 : R5 + échantillons courts entiers, délai GPU supervisé, détail par voix et diagnostic avant synthèse.
# - sami-dubbing-v5-japanese-identity-r5-r2 : TEST R5-R1 + identité vocale seule en JP, contrôle de chaque réplique et petites répliques bornées si non confirmées ; comparer avant activation.
# - sami-dubbing-v5-japanese-bounded-r5-r3 : TEST R5-R2 + budget de tokens par texte JP, fin Qwen vérifiée avant décodage et diagnostic interne ; aucune sortie tronquée validée.
# - sami-dubbing-v5-english-identity-r5-r4 : TEST R5-R3 + identité vocale seule en EN (échantillons/extrait/complet) ; FR, JP et contrôles qualité conservés.
# - sami-dubbing-v6-clean-phrases-r9-r1 : V6 hybride Pyannote/Sortformer, mots horodatés, accélération 1,3×.
# Le profil sélectionne et verrouille lui-même son modèle de diarisation et ses paramètres de génération.
# Pyannote Community-1 exige l'acceptation personnelle de ses conditions sur
# Hugging Face uniquement pour le téléchargement. Aucun jeton n'est requis au runtime.

HTTPS="https://localhost"
PORTS="1234"
PUBLIC_URL="https://localhost:1234"
PUBLIC_HOST="localhost:1234"
HTTPSEXTERNE="https://example.com"
PORTSEXTERNE="443"

USERNAMESUPERADMIN="superadmin"
PASSWORDSUPERADMIN="change-me"
EMAILSUPERADMIN="superadmin@example.com"

USERNAMEADMIN="admin"
PASSWORDADMIN="change-me"
EMAILADMIN="admin@example.com"

SMTP_HOST="smtp.mail.ovh.net"
SMTP_PORT="465"
SMTP_USER="no-reply@example.com"
SMTP_PASS="smtp-password"
SMTP_FROM='"SAMI" <no-reply@example.com>'
