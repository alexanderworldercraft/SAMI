# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files (including space-suffixed copies such as ".env prod")
.env*
!.env.exemple
!.env.example
!backend/.env.pcfixe.exemple

# Build outputs
build/
dist/
frontend/build/
outputs/*

# Permanent inputs for the people credits seed
!outputs/film_credits/
outputs/film_credits/*
!outputs/film_credits/film_acteurs_principaux.csv
!outputs/film_credits/film_realisateurs.csv
!outputs/series_credits/
outputs/series_credits/*
!outputs/series_credits/series_acteurs_principaux.csv
!outputs/series_credits/series_realisateurs.csv

# Local media and generated user data
backend/uploads/
backend/uploads/**
backend/var/
uploads/

# Archives and legacy exports
archives/
archive/

# SSL secrets
backend/ssl/

# Logs and runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Tool caches
.cache/
.eslintcache
coverage/
.nyc_output/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Portable local AI diagnostics (outside backend/var)
backend/input-english-*/
backend/input-english-*.zip
backend/input-japanese-*/
backend/input-japanese-*.zip
backend/failure-*/
backend/failure-*.zip

# Local database backups (keep Prisma SQL migrations versioned)
*.sql.gz
*.sql.zip
*.sql.bak

# Prisma local artifacts
backend/prisma/dev.db
backend/prisma/dev.db-journal
